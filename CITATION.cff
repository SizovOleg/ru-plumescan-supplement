    notes: "Independent catalogue used for cross-checking (Tier 1), CC BY 4.0"
  - type: database
    authors:
      - name: "United Nations Environment Programme, International Methane Emissions Observatory"
    title: "Methane Alert and Response System (MARS)"
    url: "https://methanedata.unep.org"
    year: 2026
    notes: "Independent catalogue used for cross-checking (Tier 2), CC BY-NC-SA 4.0, retrieved 2026-05-15, not redistributed here"
  - type: data
    authors:
      - name: "Copernicus / European Space Agency"
    title: "Sentinel-5P TROPOMI L3 CH4"
    url: "https://developers.google.com/earth-engine/datasets/catalog/COPERNICUS_S5P_OFFL_L3_CH4"
    year: 2025
    notes: "Source measurements"
